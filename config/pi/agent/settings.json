{
  "theme": "gruvbox-material",
  "packages": [
    "npm:@capdiem/pi-ask-user",
    "npm:@ff-labs/pi-fff",
    "npm:@gamaraan/todos-tool",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-plan-mode",
    "npm:pi-background-tasks",
    "npm:pi-context-view",
    "npm:pi-hashline-edit-pro",
    "npm:pi-lens",
    "npm:pi-mcp-adapter",
    "npm:pi-mono-review",
    "npm:pi-simplify",
    "npm:pi-web-access",
    "npm:pi-x-search",
    "npm:pi-zentui@0.25.0",
    "npm:@amaster.ai/pi-memory-mem0",
    "npm:@joemccann/pi-pdf"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 45000,
    "keepRecentTokens": 30000
  },
  "markdown": {
    "mermaid": "final"
  },
  "pi-memory-mem0": {
    "mode": "embedded",
    "oss": {
      "llm": {
        "provider": "${MEM0_PROVIDER:-litellm}",
        "config": {
          "model": "${MEM0_LLM_MODEL}"
        }
      },
      "embedder": {
        "provider": "${MEM0_PROVIDER:-litellm}",
        "config": {
          "model": "${MEM0_EMBED_MODEL}"
        }
      },
      "customInstructions": "Extract only durable, reusable facts about the user and their environment. Each fact: under 25 words, atomic (one fact per entry), present tense. Include: tooling/workflow preferences, machine/environment setup, project layout, stable corrections. Exclude: quotes or summaries of previous answers, transient debugging state, one-off task details, file contents, and anything not confirmed by the user. Unrelated chatter must yield an empty facts list."
    },
    "topK": 3,
    "recallFrequency": "session",
    "autoCapture": false
  }
}
