Backport of NixOS/nixpkgs#563824 (merged to master 2026-09-16, not yet in
nixos-unstable). playwright 1.63.0 bumped the webkit build to one that links
libmanette, but it was missing from buildInputs, so auto-patchelf fails:

  error: auto-patchelf could not satisfy dependency libmanette-0.2.so.0
         wanted by .../minibrowser-wpe/lib/libWPEWebKit-2.0.so.1.12.0

Drop this file once the fix reaches nixos-unstable.

diff --git a/pkgs/development/web/playwright/webkit.nix b/pkgs/development/web/playwright/webkit.nix
--- a/pkgs/development/web/playwright/webkit.nix
+++ b/pkgs/development/web/playwright/webkit.nix
@@ -32,6 +32,7 @@
   libgcrypt,
   libgpg-error,
   libjpeg8,
+  libmanette,
   libopus,
   libpng,
   libsoup_3,
@@ -167,6 +168,7 @@ let
       libgcrypt
       libgpg-error
       libjpeg8
+      libmanette
       libopus
       libpng
       libsoup_3
